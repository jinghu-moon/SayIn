* text=auto eol=lf
*.md text whitespace=-blank-at-eol
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.ico binary
*.jar binary
*.webp binary
*.jpg binary
*.zip binary
# Benchmark evidence is byte-addressed by SHA-256; preserve its original bytes.
docs/benchmarks/** -text whitespace=cr-at-eol
# Preserve upstream license notice bytes and their intentional whitespace.
docs/licenses/translation/** -text whitespace=-blank-at-eol,-space-before-tab,-blank-at-eof
